generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  nationality String
  birthYear   Int
  deathYear   Int?
  bio         String    @db.Text
  statement   String?   @db.Text
  // Story 3.11 (FR-19) : page publique gérée par l'équipe, écrite seulement par le module curation.
  // formation et expositions : textes libres ; atelierUrl : photo d'atelier (Cloudinary).
  formation   String?   @db.Text
  expositions String?   @db.Text
  atelierUrl  String?
  imageUrl    String
  coverUrl    String?
  website     String?
  featured    Boolean   @default(false)
  active      Boolean   @default(true)
  artworks    Artwork[]
  invitations Invitation[]
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id])
  // Story 2.7 (FR-16) : date de signature de l'accord écrit, enregistrée par l'équipe ; sans elle,
  // aucune œuvre de l'artiste n'est publiée. Écrite seulement par le module curation.
  accordSigneLe DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([featured])
}

model Artwork {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  year        Int
  medium      String
  description String             @db.Text
  imageUrl    String
  // AD-5, AD-20 (story 2.1) : valeurs exactes, seules colonnes du prix et des dimensions depuis la
  // story 2.10 (anciennes colonnes price et dimensions supprimées).
  prixCentimes Int?
  devise       String             @default("EUR")
  hauteurMm    Int?
  largeurMm    Int?
  profondeurMm Int?
  // AD-6, AD-20 (story 2.2) : deux axes distincts. Écrits seulement par les modules curation
  // (publication) et disponibilite (disponibilite) ; l'ancienne colonne available est supprimée
  // (story 2.10). Facultatives, sans valeur par défaut (œuvres antérieures à la story 2.2).
  publication   Publication?
  disponibilite Disponibilite?
  featured    Boolean            @default(false)
  artist      Artist             @relation(fields: [artistId], references: [id])
  artistId    String
  exhibitions ArtworkExhibition[]
  offresLivraison OffreLivraison[]
  // Story 2.5 (FR-20) : dépôt par l'artiste. Codes snake_case des listes fermées de
  // src/lib/curation/depot-regles.ts ; écrits seulement par le module curation.
  ambiance         String?
  couleurDominante String?
  photos           PhotoOeuvre[]
  decisionsCuration DecisionCuration[]
  declarationsDisponibilite DeclarationDisponibilite[]
  demandesVisite    DemandeVisite[]
  // Story 2.6 (FR-20) : visites en atelier (null : pas encore renseignée), trois engagements de
  // l'artiste et date d'envoi en curation (ordre de la file, story 2.7). Écrits seulement par curation.
  visitesAtelier       Boolean?
  engagementCertificat Boolean   @default(false)
  engagementEmballage  Boolean   @default(false)
  engagementReprise    Boolean   @default(false)
  envoyeeEnCurationLe  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([slug])
  @@index([artistId])
  @@index([featured])
  @@index([publication, disponibilite])
}

// Story 2.2 : publication d'une œuvre (curation).
enum Publication {
  brouillon
  en_curation
  publiee
}

// Story 2.2 : disponibilité d'une œuvre à la vente.
enum Disponibilite {
  disponible
  reservee
  vendue
  vendue_ailleurs
  retiree
}

// Story 2.7 (FR-25) : décisions de l'équipe sur une œuvre en curation, conservées ; écrites
// seulement par le module curation. `controle` : codes de la liste de contrôle cochés.
// `adminId` : utilisateur admin auteur (sans clé étrangère, comme Invitation.creeParId).
enum TypeDecisionCuration {
  valider
  renvoyer
}

model DecisionCuration {
  id          String               @id @default(cuid())
  artwork     Artwork              @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  artworkId   String
  decision    TypeDecisionCuration
  commentaire String?              @db.Text
  controle    String[]             @default([])
  adminId     String?
  createdAt   DateTime             @default(now())

  @@index([artworkId, createdAt])
}

// Story 2.8 (FR-21) : déclaration de l'artiste sur la disponibilité d'une œuvre publiée
// (vendue ailleurs, retirée). Écrite seulement par le module disponibilite. reservationInterrompue
// reste faux tant qu'il n'existe pas de réservation (epic 6) ; annuleeLe : « Annuler » dans le délai.
enum TypeDeclarationDisponibilite {
  vendue_ailleurs
  retiree
}

model DeclarationDisponibilite {
  id                     String                       @id @default(cuid())
  artwork                Artwork                      @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  artworkId              String
  type                   TypeDeclarationDisponibilite
  userId                 String
  reservationInterrompue Boolean                      @default(false)
  annuleeLe              DateTime?
  createdAt              DateTime                     @default(now())

  @@index([artworkId, createdAt])
}

// Story 2.5 : une photo (ou vidéo) par prise de vue attendue, envoyée directement à Cloudinary
// par le navigateur (envoi signé). Écrite seulement par le module curation.
enum TypePhoto {
  face_lumiere_du_jour
  gros_plan
  mise_en_situation
  video
}

model PhotoOeuvre {
  id        String    @id @default(cuid())
  artwork   Artwork   @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  artworkId String
  type      TypePhoto
  url       String
  publicId  String
  largeur   Int?
  hauteur   Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([artworkId, type])
}

model Exhibition {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  subtitle    String?
  description String             @db.Text
  location    String
  startDate   DateTime
  endDate     DateTime
  imageUrl    String
  featured    Boolean            @default(false)
  artworks    ArtworkExhibition[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([slug])
  @@index([startDate, endDate])
}

model ArtworkExhibition {
  artwork      Artwork    @relation(fields: [artworkId], references: [id])
  artworkId    String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id])
  exhibitionId String

  @@id([artworkId, exhibitionId])
}

// ── NextAuth models ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user")
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  artist        Artist?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Commerce models ──────────────────────────────────────────────────────────

model Order {
  id                     String   @id @default(cuid())
  stripeSessionId        String   @unique
  stripePaymentIntentId  String?  @unique
  userId                 String?
  user                   User?    @relation(fields: [userId], references: [id])
  artworkIds             String   // comma-separated slugs
  amount                 Float    // in euros
  currency               String   @default("eur")
  status                 String   @default("paid")
  customerEmail          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@index([stripeSessionId])
}

// Contacts laissés sur la page de maintenance pour être prévenus de l'ouverture (FR-35).
// Propriétaire : module demandes. Un e-mail (normalisé en minuscules) n'est inscrit qu'une fois.
model InscriptionOuverture {
  id             String   @id @default(cuid())
  email          String   @unique
  consentementLe DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
}

// Envois du formulaire d'inscription, pour en limiter le nombre par adresse IP et par e-mail.
// La clé est une empreinte (« ip:<sha256> » ou « email:<sha256> ») : ni IP ni e-mail en clair.
model TentativeInscription {
  id        String   @id @default(cuid())
  cle       String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([cle, createdAt])
  @@index([createdAt])
}

// ── Demandes de sélection (FR-8, story 4.2) ─────────────────────────────────
// Écrites seulement par le module demandes, seul propriétaire des coordonnées des visiteurs.
// Jamais d'adresse ni de téléphone dans les journaux ni dans les événements (ids seulement).
enum EtatDemande {
  nouvelle
  planifiee
  faite
  sans_suite
}

model DemandeSelection {
  id             String      @id @default(cuid())
  espace         String      @db.Text
  ambiances      String[]    @default([])
  precision      String?     @db.Text
  budgetCentimes Int
  email          String
  telephone      String?
  etat           EtatDemande @default(nouvelle)
  // Dernier changement d'état seulement (story 4.6) : identifiant de l'utilisateur, sans relation.
  etatChangePar  String?
  etatChangeLe   DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  @@index([etat, createdAt])
  @@index([email, createdAt])
}

// ── Demandes de visite (FR-8, UJ-4, story 4.3) ─────────────────────────────
// Rattachées à une œuvre ; écrites seulement par le module demandes. Créneaux proposés par le
// visiteur, enregistrés en UTC, avec le fuseau IANA de son appareil (pour les lui réafficher).
enum TypeVisite {
  distance
  atelier
}

model DemandeVisite {
  id        String      @id @default(cuid())
  // Œuvre supprimée : la demande reste, sans lien (décision du porteur du 2026-11-10).
  artwork   Artwork?    @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  artworkId String?
  type      TypeVisite
  creneaux  DateTime[]  @db.Timestamptz(3)
  fuseau    String
  email     String
  telephone String?
  etat      EtatDemande @default(nouvelle)
  // Dernier changement d'état seulement (story 4.6) : identifiant de l'utilisateur, sans relation.
  etatChangePar String?
  etatChangeLe  DateTime? @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  @@index([etat, createdAt])
  @@index([email, createdAt])
  @@index([artworkId])
}

// ── Livraison (AD-12, story 2.3) ─────────────────────────────────────────────
// Zones gérées par l'équipe (module livraison), jamais codées en dur. Le code pays (ISO 3166-1
// alpha-2) est la clé de ZonePays : un pays appartient au plus à une zone.

model Zone {
  id        String           @id @default(cuid())
  nom       String           @unique
  pays      ZonePays[]
  offres    OffreLivraison[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ZonePays {
  codePays String @id @db.VarChar(2)
  zone     Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneId   String

  @@index([zoneId])
}

// Une offre par œuvre et par zone, saisie par l'artiste (story 2.6), écrite seulement par livraison :
// livrée (frais et délais renseignés) ou « je ne livre pas » (livree = false, frais et délais vides).
// Contraintes CHECK écrites à la main dans la migration 2.6 (Prisma ne les décrit pas) : frais et
// délais positifs, transport min ≤ max, devise sur trois lettres, valeurs présentes si livrée, vides sinon.
// Restrict : une zone utilisée par une offre ne peut pas être supprimée, même hors application.
model OffreLivraison {
  id                String   @id @default(cuid())
  artwork           Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  artworkId         String
  zone              Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  zoneId            String
  livree            Boolean  @default(true)
  fraisCentimes     Int?
  devise            String   @default("EUR")
  preparationJours  Int?
  transportMinJours Int?
  transportMaxJours Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([artworkId, zoneId])
  @@index([zoneId])
}

// ── Accès (AD-14, story 2.4) ─────────────────────────────────────────────────
// Jetons créés et vérifiés seulement par le module acces : seule l'empreinte SHA-256 est stockée.
// Les autres usages d'AD-14 (suivi, desinscription, commande_assistee) viendront avec leurs epics.

enum UsageJeton {
  invitation
  desinscription
}

model Jeton {
  id         String     @id @default(cuid())
  empreinte  String     @unique
  usage      UsageJeton
  cible      String
  echeance   DateTime
  consommeLe DateTime?
  revoqueLe  DateTime?
  createdAt  DateTime   @default(now())

  @@index([usage, cible])
}

// Invitation d'un artiste existant (FR-34) ; le jeton qui la porte a pour cible son id.
model Invitation {
  id            String    @id @default(cuid())
  artist        Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artistId      String
  email         String
  creeParId     String?
  accepteeLe    DateTime?
  charteVersion String?
  createdAt     DateTime  @default(now())
  // Story 4.1 : résultat de l'envoi de l'e-mail d'invitation (le jeton n'est émis qu'à l'envoi).
  envoyeeLe     DateTime?
  echecEnvoiLe  DateTime?

  @@index([artistId])
}

// Story 3.4 (AD-11, AR-9) : journal d'événements (outbox). Écrit par `evenements` dans la
// transaction du changement d'état ; charge = ids seulement, jamais de donnée personnelle.
model Evenement {
  id          String                @id @default(cuid())
  nom         String
  version     Int                   @default(1)
  charge      Json
  createdAt   DateTime              @default(now())
  traitements TraitementEvenement[]
}

// Réclamation atomique (événement, gestionnaire) : la clé composite garantit un seul traitement.
model TraitementEvenement {
  evenement    Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  evenementId  String
  gestionnaire String
  traiteLe     DateTime  @default(now())

  @@id([evenementId, gestionnaire])
}

// ── Mesure du tunnel (FR-27, AD-19, story 4.8) ──────────────────────────────
// Taux de consentement et de refus seulement : un compteur par jour et par choix, sans identifiant,
// sans IP ni cookie. Écrit seulement par le module mesure.
enum ChoixMesure {
  accepte
  refuse
}

model CompteurChoixMesure {
  jour   DateTime    @db.Date
  choix  ChoixMesure
  nombre Int         @default(0)

  @@id([jour, choix])
}
